# Copy to .env, then replace the empty value with your own password (9+ chars).
PSC_PASSWORD=
PSC_ALLOWED_HOSTS=localhost,127.0.0.1
# Proxy whose X-Real-IP / X-Forwarded-Proto are believed. With a host nginx in front of the
# published port use: gateway (see deploy/DEPLOYMENT.md, section "Вход").
PSC_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Calendar dates for deadlines; example for UTC+5: Asia/Yekaterinburg
PSC_TIMEZONE=UTC
